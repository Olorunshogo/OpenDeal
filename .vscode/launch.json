{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Cargo: debug opendeal-api",
      "type": "lldb",
      "request": "launch",
      "cargo": {
        "args": ["build", "--bin=opendeal-api", "--manifest-path=${workspaceFolder}/crates/opendeal-api/Cargo.toml"]
      },
      "args": [],
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "Next.js: debug server-side",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev",
      "cwd": "${workspaceFolder}/frontend",
      "serverReadyAction": {
        "pattern": "started server on .+, url: (https?://.+)",
        "uriFormat": "%s",
        "action": "debugWithChrome"
      }
    },
    {
      "name": "Next.js: debug client-side",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:3000"
    },
    {
      "name": "Next.js: debug full stack",
      "type": "node-terminal",
      "request": "launch",
      "command": "pnpm dev",
      "cwd": "${workspaceFolder}/frontend",
      "serverReadyAction": {
        "pattern": "started server on .+, url: (https?://.+)",
        "uriFormat": "%s",
        "action": "debugWithChrome"
      },
      "cascadeTerminateToConfigurations": ["Next.js: debug client-side"]
    }
  ]
}
