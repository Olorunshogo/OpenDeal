APP_ENV=development
PORT=8080
# Compose maps Postgres to host :5434 by default (avoids clashing with a local Postgres on :5432).
# Override with POSTGRES_HOST_PORT=5432 if you want the classic port.
DATABASE_URL=postgres://opendeal:opendeal@127.0.0.1:5434/opendeal
DATABASE_ADMIN_URL=postgres://opendeal:opendeal@127.0.0.1:5434/opendeal
RUN_MIGRATIONS=true
CORS_ALLOWED_ORIGINS=http://localhost:3000
JWT_SECRET=dev-jwt-secret-change-me-32chars!!
SETTLEMENT_MODEL=bitcoin_multisig_2of3
BITCOIN_NETWORK=regtest
BITCOIN_RPC_URL=http://opendeal:opendeal@127.0.0.1:18443
BITCOIN_REQUIRED_CONFIRMATIONS=1
# Pilot amount cap (sats). Unset = network default (none on regtest; 100k testnet/signet; 50k mainnet).
# Set 0 to disable the cap. See docs/testnet-pilot.md.
# PILOT_MAX_AMOUNT_SATS=100000
OPENDEAL_ALLOW_MAINNET=false
# Operator attestation that an external review of opendeal-bitcoin exists. Required to boot mainnet.
OPENDEAL_SECURITY_REVIEW_ACK=false
# Known counterparties. Required on mainnet. Empty allows any pubkey locally.
OPENDEAL_ALLOWED_PUBKEYS=
# Second bitcoind used only when the primary RPC errors.
# BITCOIN_RPC_URL_FALLBACK=
RATE_LIMIT_PER_MINUTE=120
# Production Lightning/fiat. Both URL and key required together. See docs/rails.md.
# LIGHTNING_API_URL=
# LIGHTNING_API_KEY=
# FIAT_API_URL=
# FIAT_API_KEY=
MEDIATOR_PUBKEYS=
# Testnet example (point RPC at a synced testnet bitcoind; use faucet coins):
# BITCOIN_NETWORK=testnet
# BITCOIN_RPC_URL=http://user:pass@127.0.0.1:18332
# BITCOIN_REQUIRED_CONFIRMATIONS=1
# PILOT_MAX_AMOUNT_SATS=100000
# MEDIATOR_PUBKEYS=<hex>,<hex>
WEBHOOK_SIGNING_SECRET=dev-webhook-signing-secret-change-me!!
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_RETRY_INTERVAL_SECS=15
REQUEST_TIMEOUT_SECONDS=30
MAX_BODY_KB=1024
ACCESS_TOKEN_TTL_MINUTES=60
EVIDENCE_DIR=./data/evidence
# Optional object storage (Cloudflare R2 / S3-compatible). All four required together.
# R2_BUCKET=
# R2_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_REGION=auto
# Optional email (Resend). Both required together.
# RESEND_API_KEY=
# EMAIL_FROM=OpenDeal <noreply@example.com>
# Optional observability
# OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317
# SENTRY_DSN=
