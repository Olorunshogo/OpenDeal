APP_ENV=development
PORT=8080
DATABASE_URL=postgres://opendeal:replace-with-local-db-password@127.0.0.1:5433/opendeal
DATABASE_ADMIN_URL=postgres://opendeal:replace-with-local-db-password@127.0.0.1:5433/opendeal
RUN_MIGRATIONS=true
CORS_ALLOWED_ORIGINS=http://localhost:3000
JWT_SECRET=dev-jwt-secret-change-me-32chars!!
SETTLEMENT_MODEL=bitcoin_multisig_2of3
BITCOIN_NETWORK=regtest
BITCOIN_RPC_URL=http://127.0.0.1:18445
BITCOIN_RPC_USER=polaruser
BITCOIN_RPC_PASSWORD=replace-with-local-rpc-password
BITCOIN_REQUIRED_CONFIRMATIONS=1
OPENDEAL_ALLOW_MAINNET=false
MEDIATOR_PUBKEYS=
WEBHOOK_SIGNING_SECRET=dev-webhook-signing-secret-change-me!!
REQUEST_TIMEOUT_SECONDS=30
MAX_BODY_KB=1024
ACCESS_TOKEN_TTL_MINUTES=60

# Settlement policy: both limits apply (1000 basis points = 10%).
BITCOIN_MAX_FEE_SATS=10000
BITCOIN_MAX_FEE_BPS=1000
