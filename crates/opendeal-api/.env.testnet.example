# Testnet pilot config. See ../../docs/testnet-pilot.md for the full checklist.
# cp -n crates/opendeal-api/.env.testnet.example crates/opendeal-api/.env
# then fill in BITCOIN_RPC_URL, the three pubkeys, and JWT_SECRET before starting the API.

APP_ENV=development
PORT=8080
DATABASE_URL=postgres://opendeal:opendeal@127.0.0.1:5434/opendeal
DATABASE_ADMIN_URL=postgres://opendeal:opendeal@127.0.0.1:5434/opendeal
RUN_MIGRATIONS=true
CORS_ALLOWED_ORIGINS=http://localhost:3000
# At least 32 chars. Generate one; do not reuse the dev value.
JWT_SECRET=
SETTLEMENT_MODEL=bitcoin_multisig_2of3

BITCOIN_NETWORK=testnet
# Point at a synced testnet bitcoind this machine can reach.
BITCOIN_RPC_URL=http://user:pass@127.0.0.1:18332
BITCOIN_REQUIRED_CONFIRMATIONS=1
# Second bitcoind used only when the primary RPC errors (optional).
# BITCOIN_RPC_URL_FALLBACK=

# Unset = network default (100_000 sats on testnet). Lower this for a first pilot deal.
PILOT_MAX_AMOUNT_SATS=100000

OPENDEAL_ALLOW_MAINNET=false
OPENDEAL_SECURITY_REVIEW_ACK=false

# Seller, buyer, mediator hex pubkeys for this pilot — known counterparties only.
OPENDEAL_ALLOWED_PUBKEYS=<seller-hex>,<buyer-hex>,<mediator-hex>
MEDIATOR_PUBKEYS=<mediator-hex>

RATE_LIMIT_PER_MINUTE=120
WEBHOOK_SIGNING_SECRET=
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_RETRY_INTERVAL_SECS=15
REQUEST_TIMEOUT_SECONDS=30
MAX_BODY_KB=1024
ACCESS_TOKEN_TTL_MINUTES=60
EVIDENCE_DIR=./data/evidence
